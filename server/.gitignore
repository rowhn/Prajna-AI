# Dependencies - never push node_modules (it's huge, 100MB+)
node_modules/

# Environment variables - NEVER push secrets to GitHub
.env

# Uploaded files - these belong on a CDN, not in git
src/uploads/*
!src/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Build artifacts
dist/
build/